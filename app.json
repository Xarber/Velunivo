{
  "expo": {
    "name": "Velunivo",
    "slug": "velunivo",
    "version": "0.1.20",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.velunivo.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ],
        "VelunivoNativeActivityRenderer": true
      },
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/brand/icon-dark.png",
        "tinted": "./assets/brand/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#007F6D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.velunivo.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Velunivo uses your location for ride guidance and recording.",
          "locationAlwaysAndWhenInUsePermission": "Velunivo uses location during an active ride to keep directions, Live Activities and ride recording updated when the screen is locked.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Velunivo uses motion readings for ride diagnostics and local ride records when recording is enabled."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F8",
          "image": "./assets/brand/splash-light.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#102C2B",
            "image": "./assets/brand/splash.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a vehicle picture from your photo library. Pictures stay on your device.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-widgets",
        {
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ],
      "expo-secure-store"
    ],
    "scheme": "velunivo",
    "description": "Your route. Your riding speed. Navigation and route planning for e-scooters and e-bikes.",
    "githubUrl": "https://github.com/Xarber/Velunivo"
  }
}
