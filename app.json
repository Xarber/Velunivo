{
  "expo": {
    "name": "Velunivo",
    "slug": "velunivo",
    "version": "0.1.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.velunivo.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/brand/icon-dark.png",
        "tinted": "./assets/brand/icon-tinted.png"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#007F6D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.velunivo.mobile",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Velunivo uses your location for ride guidance and recording."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "Velunivo shows motion readings during your ride."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F7F8",
          "image": "./assets/brand/splash-light.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#102C2B",
            "image": "./assets/brand/splash.png"
          }
        }
      ]
    ],
    "scheme": "velunivo",
    "description": "Your route. Your riding speed. Navigation and route planning for e-scooters and e-bikes.",
    "githubUrl": "https://github.com/Xarber/Velunivo"
  }
}
