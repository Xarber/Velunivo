{
  "schema": 1,
  "api": 1,
  "id": "example.storage",
  "name": "Local counter example",
  "version": "1.0.0",
  "description": "Demonstrates private plugin storage and interactive cards.",
  "permissions": [
    "ui.cards",
    "storage"
  ],
  "code": "let count=Number(await api.storage.get('count'))||0;function render(){api.ui.card({id:'count',slot:'plugins',title:'Local counter',text:String(count),action:{id:'add',label:'Add one'}});}render();api.on('action',async id=>{if(id==='add'){count++;await api.storage.set('count',count);render();}});"
}
