# Never put GraphHopper's private key in an EXPO_PUBLIC variable.
# iPhone: use an HTTPS server or your Mac's LAN IP (not localhost).
EXPO_PUBLIC_ROUTING_URL=http://localhost:8787
# Default OpenFreeMap streets need no key. Configure your licensed
# streets style for detailed online maps and an offline-capable provider for packs.
# EXPO_PUBLIC_MAP_STYLE_URL=https://your-provider/streets/style.json?key=PUBLIC_TILE_KEY
EXPO_PUBLIC_ALLOW_OFFLINE_DOWNLOADS=false

# Native builds embed this origin; web defaults to its current origin if unset.
# Set SHARE_ORIGIN in GitHub repository variables for all build jobs on forks.
EXPO_PUBLIC_SHARE_ORIGIN=https://velunivo.xcenter.it
# Optional: separate signaling server (otherwise the share origin + /peer).
# EXPO_PUBLIC_PEER_HOST=velunivo.xcenter.it
# EXPO_PUBLIC_PEER_PORT=443
# EXPO_PUBLIC_PEER_PATH=/peer
# EXPO_PUBLIC_PEER_SECURE=true
# Optional public/short-lived TURN credentials; these are embedded in the app.
# EXPO_PUBLIC_PEER_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
