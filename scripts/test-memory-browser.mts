/** Optional real WebRTC/MediaRecorder test. Requires a local Playwright installation; never requests devices. */
import {createRequire} from 'node:module';import {memoryRecorderHTML} from '../src/groups/memoryRecorderScript';
const require=createRequire(process.env.VELUNIVO_PLAYWRIGHT_PACKAGE||import.meta.url);const {chromium}=require('playwright');
const browser=await chromium.launch({headless:true,args:['--autoplay-policy=no-user-gesture-required']}),page=await browser.newPage();const errors:string[]=[];page.on('pageerror',(e:Error)=>errors.push(e.message));await page.evaluate('window.__name=(fn)=>fn');await page.evaluate(()=>{(window as any).packets=[];(window as any).ReactNativeWebView={postMessage:(text:string)=>(window as any).packets.push(JSON.parse(text))};});await page.setContent(memoryRecorderHTML.replace('recorder.ondataavailable=event=>{','recorder.ondataavailable=event=>{send({type:"debug",size:event.data.size});'));await page.waitForFunction(()=>(window as any).packets.some((p:any)=>p.type==='ready'));
await page.evaluate(async()=>{const w=window as any;w.originalPost=w.ReactNativeWebView.postMessage;w.early=[];w.sender=new RTCPeerConnection({iceServers:[]});const context=new AudioContext();await context.resume();const oscillator=context.createOscillator(),destination=context.createMediaStreamDestination();oscillator.connect(destination);oscillator.start();w.context=context;w.oscillator=oscillator;const canvas=document.createElement('canvas');canvas.width=160;canvas.height=120;const draw=()=>{const c=canvas.getContext('2d')!;c.fillStyle='teal';c.fillRect(0,0,160,120);c.fillStyle='white';c.fillText(String(Date.now()),10,60);};w.draw=setInterval(draw,100);draw();const stream=new MediaStream([...destination.stream.getAudioTracks(),...canvas.captureStream(10).getVideoTracks()]);w.stream=stream;stream.getTracks().forEach(t=>w.sender.addTrack(t,stream));w.sender.onicecandidate=(e:any)=>{if(e.candidate)w.memoryCommand({type:'ice',id:'test',candidate:e.candidate.toJSON()});};w.ReactNativeWebView.postMessage=(text:string)=>{const p=JSON.parse(text);w.packets.push(p);if(p.type==='answer'){w.sender.setRemoteDescription(p.description).then(async()=>{for(const c of w.early)await w.sender.addIceCandidate(c);w.early=[];});}if(p.type==='ice'){if(w.sender.remoteDescription)w.sender.addIceCandidate(p.candidate);else w.early.push(p.candidate);}};const offer=await w.sender.createOffer();await w.sender.setLocalDescription(offer);w.memoryCommand({type:'offer',id:'test',description:offer});});
await page.waitForFunction(()=>(window as any).packets.some((p:any)=>p.type==='start'));await page.waitForTimeout(7000);await page.evaluate(()=>(window as any).memoryCommand({type:'stop',id:'test'}));await page.waitForFunction(()=>(window as any).packets.some((p:any)=>p.type==='end'),{timeout:10000});await page.waitForTimeout(2000);const report=await page.evaluate(async()=>{const w=window as any;const packets=w.packets.filter((p:any)=>p.type==='data');const blob=new Blob(packets.map((p:any)=>Uint8Array.from(atob(p.data),c=>c.charCodeAt(0))),{type:w.packets.find((p:any)=>p.type==='start').mime});const video=document.createElement('video');video.src=URL.createObjectURL(blob);await new Promise<void>((resolve,reject)=>{video.onloadedmetadata=()=>resolve();video.onerror=()=>reject(new Error('Recorded media is not playable'));});if(!video.videoWidth)throw new Error('Recorded video has no decoded frames');URL.revokeObjectURL(video.src);w.stream.getTracks().forEach((t:any)=>t.stop());w.sender.close();w.oscillator.stop();w.context.close();clearInterval(w.draw);return {start:w.packets.find((p:any)=>p.type==='start'),chunks:w.packets.filter((p:any)=>p.type==='data').length,bytes:w.packets.filter((p:any)=>p.type==='data').reduce((n:number,p:any)=>n+atob(p.data).length,0),errors:w.packets.filter((p:any)=>p.type==='error')};});console.log(JSON.stringify({report,errors}));await browser.close();if(errors.length||report.errors.length||report.bytes<1000)process.exitCode=1;
